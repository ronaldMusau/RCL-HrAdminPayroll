          <!-- ═══════════════════════════════════════════════════════════ -->
          <!--  LINES SECTION  — Weekly Grid Tablix                       -->
          <!--  Columns: No | Names | P.H | MON | TUE | WED | THU | FRI  -->
          <!--           | SAT | SUN                                       -->
          <!--  Grouped by Employee_No_ (one row per employee)            -->
          <!-- ═══════════════════════════════════════════════════════════ -->
          <Rectangle Name="LinesSection">
            <ReportItems>
              <Textbox Name="LinesHeading">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>SHIFT LINES</Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                </Paragraphs>
                <Top>0.05in</Top>
                <Left>0.5in</Left>
                <Height>0.25in</Height>
                <Width>11in</Width>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                </Style>
              </Textbox>
              <!-- ─── Weekly Grid Tablix ─────────────────────────────── -->
              <!--
                Column widths (total ≈ 11in inside 0.5in left margin):
                  No:    0.45in
                  Names: 1.5in
                  P.H:   0.55in
                  Mon:   1.2in  (repeated × 7 days)
                  ...
                  Sun:   1.2in
                Total: 0.45+1.5+0.55+(7×1.2) = 10.9in  ✓
              -->
              <Tablix Name="WeeklyRosterTablix">
                <TablixBody>
                  <TablixColumns>
                    <!-- No -->
                    <TablixColumn>
                      <Width>0.45in</Width>
                    </TablixColumn>
                    <!-- Names -->
                    <TablixColumn>
                      <Width>1.5in</Width>
                    </TablixColumn>
                    <!-- P.H (Public Holiday flag) -->
                    <TablixColumn>
                      <Width>0.55in</Width>
                    </TablixColumn>
                    <!-- MON -->
                    <TablixColumn>
                      <Width>1.2in</Width>
                    </TablixColumn>
                    <!-- TUE -->
                    <TablixColumn>
                      <Width>1.2in</Width>
                    </TablixColumn>
                    <!-- WED -->
                    <TablixColumn>
                      <Width>1.2in</Width>
                    </TablixColumn>
                    <!-- THU -->
                    <TablixColumn>
                      <Width>1.2in</Width>
                    </TablixColumn>
                    <!-- FRI -->
                    <TablixColumn>
                      <Width>1.2in</Width>
                    </TablixColumn>
                    <!-- SAT -->
                    <TablixColumn>
                      <Width>1.2in</Width>
                    </TablixColumn>
                    <!-- SUN -->
                    <TablixColumn>
                      <Width>1.2in</Width>
                    </TablixColumn>
                  </TablixColumns>
                  <TablixRows>
                    <!-- ── HEADER ROW ───────────────────────────────── -->
                    <TablixRow>
                      <Height>0.32in</Height>
                      <TablixCells>
                        <!-- No -->
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="H_No">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>No</Value>
                                      <Style>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>White</Color>
                                        <FontSize>8pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Color>#004c8c</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>#003366</BackgroundColor>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <!-- Names -->
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="H_Names">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>NAMES</Value>
                                      <Style>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>White</Color>
                                        <FontSize>8pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Color>#004c8c</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>#003366</BackgroundColor>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <!-- P.H -->
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="H_PH">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>P.H</Value>
                                      <Style>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>White</Color>
                                        <FontSize>8pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Color>#004c8c</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>#003366</BackgroundColor>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <!-- MON -->
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="H_Mon">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>MON</Value>
                                      <Style>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>White</Color>
                                        <FontSize>8pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Color>#004c8c</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>#003366</BackgroundColor>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <!-- TUE -->
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="H_Tue">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>TUE</Value>
                                      <Style>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>White</Color>
                                        <FontSize>8pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Color>#004c8c</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>#003366</BackgroundColor>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <!-- WED -->
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="H_Wed">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>WED</Value>
                                      <Style>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>White</Color>
                                        <FontSize>8pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Color>#004c8c</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>#003366</BackgroundColor>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <!-- THU -->
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="H_Thu">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>THU</Value>
                                      <Style>
                                        <FontWeight>Bold</FontWeight>
                                        <Color>White</Color>
                                        <FontSize>8pt</FontSize>
                                      </Style>
                                    </TextRun>
