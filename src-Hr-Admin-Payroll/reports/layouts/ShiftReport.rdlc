                <TablixRowHierarchy>
                  <TablixMembers>
                    <!-- Header row member -->
                    <TablixMember>
                      <KeepWithGroup>After</KeepWithGroup>
                      <RepeatOnNewPage>true</RepeatOnNewPage>
                    </TablixMember>
                    <!-- Data row member — grouped by Employee_No_ -->
                    <TablixMember>
                      <Group Name="EmployeeGroup">
                        <GroupExpressions>
                          <GroupExpression>=Fields!Employee_No_.Value</GroupExpression>
                        </GroupExpressions>
                        <Filters>
                          <Filter>
                            <FilterExpression>=IIF(IsNothing(Fields!Employee_No_.Value), "", Fields!Employee_No_.Value)</FilterExpression>
                            <Operator>NotEqual</Operator>
                            <FilterValues>
                              <FilterValue />
                            </FilterValues>
                          </Filter>
                        </Filters>
                      </Group>
                      <SortExpressions>
                        <SortExpression>
                          <Value>=Fields!Employee_Name.Value</Value>
                        </SortExpression>
                      </SortExpressions>
                    </TablixMember>
                  </TablixMembers>
                </TablixRowHierarchy>
