                      </TablixCells>
                    </TablixRow>
                    <!-- ── DATA ROW (grouped by Employee_No_) ─────────── -->
                    <!--
                      Each day cell shows:
                        Line 1: Shift label  (DAY / P.M / NIGHT / OFF / S.LEAVE / A.LEAVE …)
                        Line 2: Start time   (HH\H00 format, e.g. 06H00)
                        Line 3: End time     (HH\H00 format, e.g. 14H00)
                      Background colour matches Excel:
                        DAY    → #F4A460  (sandy orange)
                        P.M    → #FFD700  (yellow)
                        NIGHT  → #87CEEB  (sky blue)
                        OFF    → White
                        *LEAVE → #90EE90  (light green)
                        P.H    → #FFA07A  (light salmon / public holiday)
                        default→ White
                    -->
                    <TablixRow>
                      <Height>0.65in</Height>
                      <TablixCells>
                        <!-- No (row number) -->
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="D_No">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=RowNumber("EmployeeGroup")</Value>
                                      <Style>
                                        <FontSize>8pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Color>#cccccc</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>=IIF(RowNumber("EmployeeGroup") Mod 2 = 0, "#f0f0f0", "White")</BackgroundColor>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <!-- Employee Name -->
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="D_Name">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=Fields!Employee_Name.Value</Value>
                                      <Style>
                                        <FontSize>8pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Color>#cccccc</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>=IIF(RowNumber("EmployeeGroup") Mod 2 = 0, "#f0f0f0", "White")</BackgroundColor>
                                <VerticalAlign>Middle</VerticalAlign>
                                <PaddingLeft>3pt</PaddingLeft>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <!-- P.H count for the week -->
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="D_PH">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=IIF(Fields!Is_Public_Holiday.Value, "1", "")</Value>
                                      <Style>
                                        <FontSize>8pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Color>#cccccc</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>=IIF(Fields!Is_Public_Holiday.Value, "#FFA07A", IIF(RowNumber("EmployeeGroup") Mod 2 = 0, "#f0f0f0", "White"))</BackgroundColor>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <!-- ── MON ── -->
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="D_Mon">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=IIF(IsNothing(Fields!Mon_Shift.Value) OR Fields!Mon_Shift.Value = "", "OFF", Fields!Mon_Shift.Value)</Value>
                                      <Style>
                                        <FontSize>8pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=IIF(IsNothing(Fields!Mon_Start_Time.Value) OR Fields!Mon_Shift.Value = "" OR Fields!Mon_Shift.Value = "OFF", "", Format(Fields!Mon_Start_Time.Value, "HH\H00"))</Value>
                                      <Style>
                                        <FontSize>7pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=IIF(IsNothing(Fields!Mon_End_Time.Value) OR Fields!Mon_Shift.Value = "" OR Fields!Mon_Shift.Value = "OFF", "", Format(Fields!Mon_End_Time.Value, "HH\H00"))</Value>
                                      <Style>
                                        <FontSize>7pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Color>#cccccc</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>=Switch(
                                Fields!Mon_Shift.Value = "DAY",   "#F4A460",
                                Fields!Mon_Shift.Value = "P.M",   "#FFD700",
                                Fields!Mon_Shift.Value = "NIGHT", "#87CEEB",
                                InStr(Fields!Mon_Shift.Value, "LEAVE") &gt; 0, "#90EE90",
                                Fields!Mon_Shift.Value = "P.H",   "#FFA07A",
                                True, "White"
                              )</BackgroundColor>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <!-- ── TUE ── -->
