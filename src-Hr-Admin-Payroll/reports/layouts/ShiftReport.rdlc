                              <Style>
                                <Border>
                                  <Color>#cccccc</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>=Switch(
                                Fields!Sun_Shift.Value = "DAY",   "#F4A460",
                                Fields!Sun_Shift.Value = "P.M",   "#FFD700",
                                Fields!Sun_Shift.Value = "NIGHT", "#87CEEB",
                                InStr(Fields!Sun_Shift.Value, "LEAVE") &gt; 0, "#90EE90",
                                Fields!Sun_Shift.Value = "P.H",   "#FFA07A",
                                True, "White"
                              )</BackgroundColor>
                                <VerticalAlign>Middle</VerticalAlign>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                      </TablixCells>
                    </TablixRow>
