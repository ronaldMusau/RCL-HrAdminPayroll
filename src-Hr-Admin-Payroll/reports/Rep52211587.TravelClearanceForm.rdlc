          <Rectangle Name="CertificationSection">
            <ReportItems>
              <Textbox Name="CertificationText">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>I hereby certify that the above-mentioned individual is a RwandAir Catering staff member and is authorized to travel to </Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>11pt</FontSize>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=Last(Fields!Destination.Value)</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>11pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value> for the purpose stated above.</Value>
                        <Style>
                          <FontFamily>Arial</FontFamily>
                          <FontSize>11pt</FontSize>
                        </Style>
